rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || resource.data.authorId == "news_bot");

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    match /channels/{channelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    match /live_streams/{streamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      match /comments/{commentId} {
        allow read, create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    match /friend_requests/{requestId} {
      allow read, create, update, delete: if isAuthenticated();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || resource.data.recipientId == "all");
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    match /reels/{reelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    match /economy_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /anime_wiki/{wikiId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /reports/{reportId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }
  }
}
